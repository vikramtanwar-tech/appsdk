<?xml version="1.0" encoding="utf-8"?>
<!-- IIS / Azure App Service. Only needed if the host does not already serve .js as JavaScript. -->
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".js" />
      <mimeMap fileExtension=".js" mimeType="text/javascript" />
    </staticContent>
    <urlCompression doStaticCompression="true" />
    <httpProtocol>
      <customHeaders>
        <!-- Camera must be allowed for this origin (and for any iframe embedding it). -->
        <add name="Permissions-Policy" value="camera=(self)" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
